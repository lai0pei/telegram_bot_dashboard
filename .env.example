# Get these from https://my.telegram.org/apps
API_ID=
API_HASH=

# 32+ char random secret used to derive the AES-256-GCM key that encrypts
# the MTProto session string and bot tokens at rest.
# Generate with: openssl rand -hex 32
APP_SECRET=

# Shared invite password required to reach the Telegram login steps.
# Give this to anyone you want to be able to log in with their own account.
DASHBOARD_PASSWORD=

# Optional: comma-separated Telegram user IDs allowed to log in.
# Leave empty to let anyone with DASHBOARD_PASSWORD sign in with their own
# Telegram account. A rejected user's ID is shown on the login page so they
# can send it to you to add here.
ALLOWED_TELEGRAM_USER_IDS=

# Where the SQLite file lives. Defaults to ./data/app.db locally,
# mounted as a Docker volume at /app/data/app.db in the container.
DATABASE_PATH=./data/app.db

# Host interface docker-compose binds port 3000 to. Defaults to
# 127.0.0.1 (local-only). Set to 0.0.0.0 to expose it on the network/
# internet (put a reverse proxy with HTTPS in front of it if you do).
HOST_BIND=127.0.0.1
