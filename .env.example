# Get these from https://my.telegram.org/apps
API_ID=
API_HASH=

# 32+ char random secret used to derive the AES-256-GCM key that encrypts
# the MTProto session string and bot tokens at rest.
# Generate with: openssl rand -hex 32
APP_SECRET=

# Optional: set to "false" once you've created your own account, so signing
# in with an unrecognized Telegram account no longer creates a new dashboard
# account (an admin must link it to an existing one first). Defaults to open
# sign-up: any Telegram account that signs in gets a dashboard account.
# The master admin can override this from Admin > Access; "Reset to .env"
# there brings this value back.
REGISTRATION_ENABLED=

# Optional: comma-separated Telegram user IDs allowed to be linked to a
# dashboard account. Leave empty to let any dashboard user link any Telegram
# account. A rejected account's Telegram ID is shown on the link-account
# page so they can send it to you to add here. Also editable (with an
# explicit on/off switch) from Admin > Access, which overrides this value.
ALLOWED_TELEGRAM_USER_IDS=

# Optional: comma-separated Telegram user IDs of the master admin(s). A
# dashboard user who has one of these Telegram accounts linked gets an Admin
# page listing everyone using the dashboard. Unlike the allowlist above,
# leaving this empty means nobody is an admin.
MASTER_ADMIN_TELEGRAM_IDS=

# Optional: a short name for this dashboard (letters, digits, spaces, dots,
# dashes). If you run two dashboards (say local and remote) signed in with the
# same Telegram account, each shows the other's name on a bot it runs, e.g.
# "Standby · runs on remote". Defaults to the host name.
INSTANCE_NAME=

# Password for the bundled Postgres container (docker-compose builds DATABASE_URL from it).
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Postgres connection string. docker-compose sets this for the app container itself;
# you only need it for local development (`docker compose up db`, then `npm run dev`)
# or to point at a different Postgres. Use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgres://tgdash:CHANGE_ME@localhost:5432/tgdash

# Optional: how many reverse proxies (nginx, Caddy, Cloudflare...) sit in
# front of the app, used to read the real client IP from X-Forwarded-For for
# the login/linking rate limits. Defaults to 1. Only the entries your own
# proxies append can be trusted, so set this to match your setup.
TRUSTED_PROXY_HOPS=

# Host interface docker-compose binds port 3000 to. Defaults to
# 127.0.0.1 (local-only). Set to 0.0.0.0 to expose it on the network/
# internet (put a reverse proxy with HTTPS in front of it if you do).
HOST_BIND=127.0.0.1
